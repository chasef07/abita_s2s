OPENAI_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GPT_LIVE_VOICE=gleam

# Required only for console tests; never overrides SIP routing.
ABITA_CONSOLE_OFFICE=spring-hill

# Set both to enable office knowledge. Use a service credential with READ_KNOWLEDGE.
ACUITY_PRODUCT_KNOWLEDGE_URL=
ABITA_EYE_GROUP_PRODUCT_SERVICE_SECRET=

# Set both to enable patient reads through /api/patient/resolve.
AMD_API_URL=
AMD_API_TOKEN=

# Optional staff delivery; derives /v1/tasks and uses the same Product secret.
# The service credential must have CREATE_TASK for the called office.
ACUITY_PRODUCT_HANDOFF_URL=
