OPENAI_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GPT_LIVE_VOICE=gleam

# Required only for console tests; never overrides SIP routing.
ABITA_CONSOLE_OFFICE=spring-hill

# Set both to enable office knowledge. Use a service credential with READ_KNOWLEDGE.
ACUITY_PRODUCT_KNOWLEDGE_URL=
ABITA_EYE_GROUP_PRODUCT_SERVICE_SECRET=

# Set both to enable patient reads through /api/patient/resolve.
AMD_API_URL=
AMD_API_TOKEN=

# Required for LiveKit simulations; use the dedicated sandbox Cloud Run service.
SANDBOX_AMD_API_URL=
SANDBOX_AMD_API_TOKEN=

# Product handoff and staff delivery (shared Product credential; CREATE_TASK for staff requests).
ACUITY_PRODUCT_HANDOFF_URL=
ABITA_EYE_GROUP_PRODUCT_PRACTICE_ID=

# Direct admission endpoint, used only without Product handoff routing.
ACUITY_HANDOFF_URL=
ACUITY_HANDOFF_SECRET=

# Product lifecycle reporting (INGEST_AI_INTERACTION on the shared Product credential).
# Disabled for console and named LiveKit deployments.
ACUITY_PRODUCT_INTERACTION_URL=
