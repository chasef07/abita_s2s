ABITA_EYE_GROUP_PRODUCT_SERVICE_SECRET=

# Set both to enable patient reads through /api/patient/resolve.
AMD_API_URL=
AMD_API_TOKEN=

# Product human handoff admission (uses the shared Product service secret above).
ACUITY_PRODUCT_HANDOFF_URL=
ABITA_EYE_GROUP_PRODUCT_PRACTICE_ID=

# Existing direct admission endpoint, used only without Product handoff routing.
ACUITY_HANDOFF_URL=
ACUITY_HANDOFF_SECRET=
